{
  "openapi": "3.1.0",
  "info": {
    "title": "EV ChargeOps API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Me",
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/import-batches/preview": {
      "post": {
        "tags": [
          "imports"
        ],
        "summary": "Preview Import",
        "operationId": "preview_import_v1_import_batches_preview_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_preview_import_v1_import_batches_preview_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportPreviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_preview_import_v1_import_batches_preview_post": {
        "properties": {
          "file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          }
        },
        "type": "object",
        "title": "Body_preview_import_v1_import_batches_preview_post"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          }
        },
        "type": "object",
        "required": [
          "field"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ImportPreviewResponse": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "checksum": {
            "type": "string",
            "title": "Checksum"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "totalCount": {
            "type": "integer",
            "title": "Totalcount"
          },
          "validCount": {
            "type": "integer",
            "title": "Validcount"
          },
          "invalidCount": {
            "type": "integer",
            "title": "Invalidcount"
          },
          "duplicateCount": {
            "type": "integer",
            "title": "Duplicatecount"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/PreviewRecordResponse"
            },
            "type": "array",
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "checksum",
          "source",
          "totalCount",
          "validCount",
          "invalidCount",
          "duplicateCount",
          "records"
        ],
        "title": "ImportPreviewResponse"
      },
      "MeResponse": {
        "properties": {
          "profileId": {
            "type": "string",
            "format": "uuid",
            "title": "Profileid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "title": "Organizationid"
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          },
          "unitId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unitid"
          }
        },
        "type": "object",
        "required": [
          "profileId",
          "organizationId",
          "role",
          "unitId"
        ],
        "title": "MeResponse"
      },
      "OrganizationRole": {
        "type": "string",
        "enum": [
          "manager",
          "resident",
          "technical_operator"
        ],
        "title": "OrganizationRole"
      },
      "PreviewRecordResponse": {
        "properties": {
          "rowNumber": {
            "type": "integer",
            "title": "Rownumber"
          },
          "classification": {
            "type": "string",
            "title": "Classification"
          },
          "raw": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Raw"
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionPreviewResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "errorField": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorfield"
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode"
          },
          "errorMessage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errormessage"
          }
        },
        "type": "object",
        "required": [
          "rowNumber",
          "classification",
          "raw"
        ],
        "title": "PreviewRecordResponse"
      },
      "SessionPreviewResponse": {
        "properties": {
          "chargerSerial": {
            "type": "string",
            "title": "Chargerserial"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Startedat"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Endedat"
          },
          "energyKwh": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Energykwh"
          },
          "chargePort": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chargeport"
          },
          "cardIdRaw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cardidraw"
          },
          "identityConfidence": {
            "type": "string",
            "title": "Identityconfidence"
          },
          "provenance": {
            "type": "string",
            "title": "Provenance"
          },
          "deduplicationKey": {
            "type": "string",
            "title": "Deduplicationkey"
          }
        },
        "type": "object",
        "required": [
          "chargerSerial",
          "startedAt",
          "endedAt",
          "energyKwh",
          "chargePort",
          "cardIdRaw",
          "identityConfidence",
          "provenance",
          "deduplicationKey"
        ],
        "title": "SessionPreviewResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
